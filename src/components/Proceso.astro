---
import {
	getTranslation,
	type Language,
	type TranslationKey,
} from "../i18n/dictionaries";
import fondoCard from "../assets/FondoCardProceso.png";
import linea from "../assets/LineProceso.png";

interface Props {
	lang: Language;
}

const { lang } = Astro.props;
const t = (key: TranslationKey) => getTranslation(key, lang);

const steps = [1, 2, 3, 4].map((n) => {
	const key = (suffix: string) =>
		`proceso.step${n}.${suffix}` as TranslationKey;
	return {
		titulo: t(key("titulo")),
		descripcion: t(key("descripcion")),
	};
});
---

<section
	id="proceso"
	class="relative isolate mx-auto flex h-270 w-full max-w-460 max-h-270 shrink-0 flex-col items-center justify-center gap-24.75 p-5 box-border text-center text-hero-xl text-white max-[1600px]:h-192 max-[1600px]:max-h-192 max-[1600px]:gap-10 max-[1600px]:text-hero-lg max-[1600px]:top-20 max-[768px]:h-auto max-[768px]:max-h-none max-[768px]:px-[25px] max-[768px]:gap-8 max-[768px]:mt-16"
>
	<div
		class="relative isolate z-0 flex w-234 flex-col items-center justify-center gap-2.5 shrink-0 max-[1600px]:w-234 max-[768px]:w-full"
	>
		<div
			class="relative self-stretch [text-shadow:0px_0px_24px_rgba(37,99,235,0.35)] max-[768px]:text-[30px]"
		>
			{t("proceso.titulo")}
		</div>
		<img
			src={linea.src}
			alt=""
			aria-hidden="true"
			class="absolute top-22.75 left-19.25 z-1 h-[20.5px] w-[781.5px] shrink-0 max-[1600px]:top-17.5 max-[1600px]:left-19.25 max-[768px]:top-[40px] max-[768px]:left-1/2 max-[768px]:-translate-x-1/2 max-[768px]:h-[15px] max-[768px]:w-[260px]"
		/>
	</div>

	<div
		class="z-1 grid shrink-0 grid-cols-[repeat(2,500px)] justify-items-center [align-content:start] gap-7.5 p-5 text-h1 box-border max-[1600px]:grid-cols-[repeat(2,380px)] max-[1600px]:gap-x-5 max-[1600px]:gap-y-7.5 max-[1600px]:mt-8 max-[768px]:grid-cols-1 max-[768px]:w-full max-[768px]:gap-y-7.5 max-[768px]:mt-0 max-[768px]:px-0"
	>
		{
			steps.map((step) => (
				<div class="relative isolate flex h-70 w-125 max-w-125 items-center justify-center gap-2.5 rounded-2xl bg-obsidian p-2.5 shadow-glow-primary box-border overflow-hidden max-[1600px]:h-50 max-[1600px]:w-95 max-[1600px]:max-w-95 max-[768px]:w-full max-[768px]:max-w-none max-[768px]:h-auto max-[768px]:flex-col max-[768px]:py-4 max-[768px]:px-5">
					<img
						src={fondoCard.src}
						alt=""
						aria-hidden="true"
						class="absolute top-29.75 -left-34 z-0 h-62 w-159 shrink-0 filter-[blur(50px)] max-[1600px]:top-29.75 max-[1600px]:-left-34 max-[1600px]:h-62 max-[1600px]:w-159 max-[768px]:hidden"
					/>
					<div class="relative z-1 flex h-58.5 shrink-0 flex-1 flex-col items-center justify-center gap-4 self-stretch p-2.5 max-[1600px]:h-39.5 max-[768px]:w-full max-[768px]:h-auto max-[768px]:font-normal">
						<div class="flex items-center justify-center py-0 px-10 max-[1600px]:px-5 max-[1600px]:text-h2 max-[768px]:text-[20px]">
							<div class="relative leading-[120%]">
								{step.titulo}
							</div>
						</div>
						<div class="flex flex-col items-center justify-center self-stretch py-0 px-10 text-base max-[1600px]:text-base max-[768px]:text-sm">
							<div class="relative self-stretch leading-[120%]">
								{step.descripcion}
							</div>
						</div>
					</div>
				</div>
			))
		}
	</div>
</section>
