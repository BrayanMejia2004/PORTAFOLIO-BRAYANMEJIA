---
const words = [
	"Design Thinking",
	"Wireframe",
	"Prototipos",
	"Design System",
	"UI/UX",
	"Figma",
];

const loop = [...words, ...words];
---

<div class="mt-60 w-full overflow-hidden bg-electric py-10">
	<div class="flex w-max animate-marquee items-center">
		{
			loop.map((word) => (
				<div class="flex shrink-0 items-center gap-10 pr-10">
					<svg
						width="50"
						height="50"
						viewBox="0 0 50 50"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
						class="aspect-square shrink-0"
					>
						<path
							d="M17.125 17.1875L25 0L32.8125 17.1875L50 25L32.8125 32.875L25 50L17.125 32.875L0 25L17.125 17.1875Z"
							fill="#60A5FA"
						/>
					</svg>
					<span class="text-lg font-semibold whitespace-nowrap text-white">
						{word}
					</span>
				</div>
			))
		}
	</div>
</div>
