---
import {
	getTranslation,
	type Language,
	type TranslationKey,
} from "../i18n/dictionaries";
import fondoCard from "../assets/FondoCard.png";
import imagenBiblioteca from "../assets/ProyectosImagenes/ImagenBiblioteca.png";
import imagenMascota from "../assets/ProyectosImagenes/ImagenMascota.png";
import imagenYTX from "../assets/ProyectosImagenes/ImagenYTX150.png";
import imagenIntercom from "../assets/ProyectosImagenes/ImagenIntercomPro.png";

interface Props {
	lang: Language;
}

const { lang } = Astro.props;
const t = (key: TranslationKey) => getTranslation(key, lang);

const images = [imagenBiblioteca, imagenMascota, imagenYTX, imagenIntercom];

const links = [
	"https://www.figma.com/design/adddViPMojOi0Ll85wsfLC/PROYECTOS?node-id=1-341&t=ZEvTjnwbKJOXqUi8-1",
	"https://www.figma.com/design/adddViPMojOi0Ll85wsfLC/PROYECTOS?node-id=1-2515&t=ZEvTjnwbKJOXqUi8-1",
	"https://www.figma.com/design/adddViPMojOi0Ll85wsfLC/PROYECTOS?node-id=1-6227&t=ZEvTjnwbKJOXqUi8-1",
	"https://www.figma.com/design/adddViPMojOi0Ll85wsfLC/PROYECTOS?node-id=0-1&t=D0AUo1UIsQUhWRl8-1",
];

const protoLinks = [
	"https://www.figma.com/proto/adddViPMojOi0Ll85wsfLC/PROYECTOS?node-id=1-341&t=bmzQd0GStatwIZ9I-1",
	"https://www.figma.com/proto/adddViPMojOi0Ll85wsfLC/PROYECTOS?node-id=1-2515&t=bmzQd0GStatwIZ9I-1",
	"https://www.figma.com/proto/adddViPMojOi0Ll85wsfLC/PROYECTOS?node-id=1-6227&t=bmzQd0GStatwIZ9I-1",
	"https://www.figma.com/proto/adddViPMojOi0Ll85wsfLC/PROYECTOS?node-id=0-1&t=bmzQd0GStatwIZ9I-1",
];

const projects = [1, 2, 3, 4].map((n, i) => {
	const key = (suffix: string) =>
		`proyectos.${n}.${suffix}` as TranslationKey;
	return {
		title: t(key("titulo")),
		description: t(key("descripcion")),
		tags: t(key("tags")).split(","),
		image: images[i],
		link: links[i],
		protoLink: protoLinks[i],
	};
});
---

<section
	id="proyectos"
	class="relative isolate mx-auto top-20 flex h-270 w-full max-h-270 flex-col items-center justify-center gap-22.5 text-center text-hero-xl text-white max-[1600px]:h-192 max-[1600px]:max-h-192 max-[1600px]:gap-10 max-[1600px]:text-hero-lg max-[768px]:h-auto max-[768px]:max-h-none max-[768px]:px-[25px] max-[768px]:text-[30px] max-[768px]:gap-10"
>
	<div class="z-0 flex w-460 flex-col items-center justify-center gap-5 max-[768px]:w-full">
		<div class="relative self-stretch leading-[120%]">
			{t("proyectos.titulo")}
		</div>
		<div
			class="relative self-stretch text-lg font-medium leading-[120%] max-[1600px]:text-base max-[768px]:text-sm max-[768px]:font-normal"
		>
			{t("proyectos.subtitulo")}
		</div>
	</div>

	<div
		data-proyectos-scroll
		class="z-1 flex w-full cursor-grab gap-7.5 overflow-x-auto px-2.5 py-5 text-left text-base select-none scrollbar-none active:cursor-grabbing max-[768px]:flex-col max-[768px]:items-center max-[768px]:overflow-visible max-[768px]:gap-8 max-[768px]:px-0"
	>
		{
			projects.map((project) => (
				<div
					class="flex h-158 w-125.25 shrink-0 items-center justify-center rounded-xl bg-cover bg-center max-[1600px]:h-125 max-[1600px]:w-96.75 max-[768px]:h-auto max-[768px]:w-full max-[768px]:shrink max-[768px]:rounded-[24px] max-[768px]:pb-6"
					style={`background-image: url(${fondoCard.src})`}
				>
					<div class="relative isolate flex w-125.25 flex-col items-center gap-2.5 max-[1600px]:w-96.25 max-[768px]:w-full">
						<div class="relative z-0 h-76.75 self-stretch rounded-t-lg rounded-b-none max-[1600px]:h-55.75 max-[768px]:h-[245px]" />

						<img
							src={project.image.src}
							alt={project.title}
							class="absolute z-1 top-12.5 left-[calc(50%-134.5px)] h-62.5 w-67.5 rounded-t-xl rounded-b-none object-contain max-[1600px]:top-[calc(50%-200px)] max-[1600px]:left-[calc(50%-89.5px)] max-[1600px]:h-42 max-[1600px]:w-45 max-[768px]:top-[28px] max-[768px]:left-[calc(50%-110px)] max-[768px]:h-[202px] max-[768px]:w-[219px]"
						/>

						<div class="z-2 flex flex-col items-start gap-4 p-5 max-[1600px]:gap-2 max-[1600px]:p-3 max-[768px]:items-center max-[768px]:gap-2.5 max-[768px]:p-4 max-[768px]:w-full">
							<div class="flex h-11.75 w-72.75 items-center py-2.5 px-0 text-h1 box-border max-[1600px]:h-11.75 max-[1600px]:w-72.75 max-[1600px]:text-[31px] max-[768px]:w-full max-[768px]:justify-center max-[768px]:text-[20px]">
								<div class="relative shrink-0 leading-[120%]">
									{project.title}
								</div>
							</div>
							<div class="flex items-center justify-center py-2.5 px-0 max-[1600px]:py-2">
								<div class="relative inline-block w-110.5 shrink-0 whitespace-pre-wrap leading-[120%] max-[1600px]:w-75 max-[1600px]:text-sm max-[768px]:w-full max-[768px]:text-sm">
									{project.description}
								</div>
							</div>
<div class="flex w-110.5 items-center justify-center gap-1.75 max-[1600px]:w-auto max-[1600px]:gap-1 max-[768px]:w-full max-[768px]:flex-wrap max-[768px]:justify-center">
							{project.tags.map((tag) => (
								<div class="flex items-center justify-center rounded-full bg-sky py-2.5 px-5 max-[1600px]:py-1.5 max-[1600px]:px-2.5 max-[1600px]:text-sm max-[768px]:py-[8px] max-[768px]:px-[20px] max-[768px]:text-[10px]">
										<div class="relative leading-[120%]">
											{tag}
										</div>
									</div>
								))}
							</div>
						</div>

						<div class="z-3 flex items-center justify-center gap-2.5 max-[1600px]:gap-2 max-[768px]:w-full max-[768px]:justify-center max-[768px]:gap-3">
							<a
								href={project.link}
								target="_blank"
								rel="noopener noreferrer"
								class="flex items-center justify-center rounded-lg border-[0.5px] border-solid border-white bg-transparent py-2.5 px-5 shadow-[0px_4px_4px_rgba(0,0,0,0.25)] transition-colors hover:bg-white/10 max-[1600px]:py-2 max-[1600px]:px-3 max-[1600px]:text-sm max-[768px]:w-auto max-[768px]:px-4 max-[768px]:whitespace-nowrap"
							>
								<div class="relative leading-[120%]">
									{t("proyectos.verProyecto")}
								</div>
							</a>
							<a
								href={project.protoLink}
								target="_blank"
								rel="noopener noreferrer"
								class="flex items-center justify-center rounded-lg border-[0.5px] border-solid border-white bg-transparent py-2.5 px-5 shadow-[0px_4px_4px_rgba(0,0,0,0.25)] transition-colors hover:bg-white/10 max-[1600px]:py-2 max-[1600px]:px-3 max-[1600px]:text-sm max-[768px]:w-auto max-[768px]:px-4 max-[768px]:whitespace-nowrap"
							>
								<div class="relative leading-[120%]">
									{t("proyectos.prototipo")}
								</div>
							</a>
						</div>
					</div>
				</div>
			))
		}
	</div>
</section>

<script>
	const scroller = document.querySelector<HTMLElement>(
		"[data-proyectos-scroll]",
	);

	if (scroller) {
		let isDown = false;
		let startX = 0;
		let scrollLeft = 0;

		scroller.addEventListener("mousedown", (e) => {
			isDown = true;
			startX = e.pageX - scroller.offsetLeft;
			scrollLeft = scroller.scrollLeft;
		});

		scroller.addEventListener("mouseleave", () => {
			isDown = false;
		});

		scroller.addEventListener("mouseup", () => {
			isDown = false;
		});

		scroller.addEventListener("mousemove", (e) => {
			if (!isDown) return;
			e.preventDefault();
			const x = e.pageX - scroller.offsetLeft;
			const walk = (x - startX) * 1.5;
			scroller.scrollLeft = scrollLeft - walk;
		});

		scroller.addEventListener("dragstart", (e) => e.preventDefault());
	}
</script>
