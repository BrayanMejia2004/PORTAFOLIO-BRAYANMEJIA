---
import { getTranslation, type Language } from "../i18n/dictionaries";
import logo from "../assets/ICONOCIRCULO.png";

interface Props {
	lang: Language;
}

const { lang } = Astro.props;
const t = (key: Parameters<typeof getTranslation>[0]) =>
	getTranslation(key, lang);

const links = [
	{ href: `/${lang}/#proyectos`, label: t("nav.proyectos") },
	{ href: `/${lang}/#sobreMi`, label: t("nav.sobreMi") },
	{ href: `/${lang}/#proceso`, label: t("nav.proceso") },
];
---

<header
	class="flex items-center justify-between rounded-t-[20px] p-5"
	style="width: 1840px; height: 150px; max-width: 1840px; max-height: 150px;"
>
	<img src={logo.src} alt="Brayan Mejia" class="h-25 w-auto" />

	<nav
		class="fixed top-12.5 left-1/2 z-50 flex -translate-x-1/2 items-center gap-7.5 rounded-[24px] border border-white/10 bg-black/0 px-8 py-4 backdrop-blur-md"
	>
		{
			links.map((link) => (
				<a
					href={link.href}
					class="text-center font-sans text-base leading-[120%] font-normal text-white transition-colors hover:text-electric hover:underline hover:decoration-electric hover:decoration-2 hover:underline-offset-8"
				>
					{link.label}
				</a>
			))
		}
	</nav>

	<div class="flex items-center gap-4">
		<a
			href="https://wa.me/573024550409"
			target="_blank"
			rel="noopener noreferrer"
			class="group flex h-12.5 w-49 items-center justify-center gap-2.5 rounded-xl bg-obsidian p-1.25 shadow-glow-primary"
		>
			<span
				class="flex w-36.5 items-center justify-center gap-2.5 self-stretch rounded-xl bg-electric p-5 text-center font-sans text-base leading-[120%] font-medium text-white transition-all duration-300 group-hover:w-full"
			>
				{t("nav.contactame")}
			</span>

			<svg
				width="30"
				height="30"
				viewBox="0 0 30 30"
				fill="none"
				class="aspect-square fill-white transition-opacity duration-300 group-hover:hidden"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					d="M0 15C0 6.71573 6.71573 0 15 0C23.2843 0 30 6.71573 30 15C30 23.2843 23.2843 30 15 30C6.71573 30 0 23.2843 0 15Z"
					fill="white"></path>
				<path
					d="M5 13.8005V16.1995H19.3939L12.7967 22.7967L14.5 24.5L24 15L14.5 5.5L12.7967 7.20328L19.3939 13.8005H5Z"
					fill="black"></path>
			</svg>
		</a>
	</div>
</header>
