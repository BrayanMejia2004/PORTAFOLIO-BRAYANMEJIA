---
import { getTranslation, type Language } from "../i18n/dictionaries";
import logo from "../assets/ICONOCIRCULO.png";

interface Props {
	lang: Language;
}

const { lang } = Astro.props;
const t = (key: Parameters<typeof getTranslation>[0]) =>
	getTranslation(key, lang);

const links = [
	{ href: `/${lang}/#proyectos`, label: t("nav.proyectos") },
	{ href: `/${lang}/#sobreMi`, label: t("nav.sobreMi") },
	{ href: `/${lang}/#proceso`, label: t("nav.proceso") },
];
---

<header
	class="flex w-full max-w-[1840px] h-37.5 max-h-37.5 items-center justify-between rounded-t-[20px] p-5 max-[1600px]:h-25 max-[1600px]:max-h-25 max-[1600px]:py-2.5 max-[768px]:h-[70px] max-[768px]:max-h-[70px] max-[768px]:px-5 max-[768px]:py-0"
>
	<img
		src={logo.src}
		alt="Brayan Mejia"
		class="h-25 w-auto max-[1600px]:h-20 max-[768px]:h-16"
	/>

	<nav
		class="fixed top-12.5 left-1/2 z-50 flex -translate-x-1/2 items-center gap-7.5 rounded-[24px] border border-white/10 bg-black/0 px-8 py-4 backdrop-blur-md max-[1600px]:top-6.25 max-[1600px]:h-12.5 max-[1600px]:rounded-3xl max-[1600px]:justify-center max-[1600px]:gap-7.5 max-[1600px]:px-7.5 max-[1600px]:py-0 max-[768px]:hidden"
	>
		{
			links.map((link) => (
				<a
					href={link.href}
					class="text-center font-sans text-base leading-[120%] font-normal text-white transition-colors hover:text-electric hover:underline hover:decoration-electric hover:decoration-2 hover:underline-offset-8"
				>
					{link.label}
				</a>
			))
		}
	</nav>

	<div class="flex items-center gap-4 max-[1600px]:gap-2.5">
		<a
			href="https://wa.me/573024550409"
			target="_blank"
			rel="noopener noreferrer"
			class="group flex h-12.5 w-49 items-center justify-center gap-2.5 rounded-xl bg-obsidian p-1.25 shadow-glow-primary max-[1600px]:h-11.25 max-[1600px]:rounded-3xl max-[1600px]:p-1.25 max-[768px]:h-10 max-[768px]:w-10 max-[768px]:p-0 max-[768px]:bg-electric max-[768px]:rounded-full"
		>
			<span
				class="flex w-36.5 items-center justify-center gap-2.5 self-stretch rounded-xl bg-electric p-5 text-center font-sans text-base leading-[120%] font-medium text-white transition-all duration-300 group-hover:w-full max-[1600px]:rounded-3xl max-[768px]:hidden"
			>
				{t("nav.contactame")}
			</span>

			<svg
				width="30"
				height="30"
				viewBox="0 0 30 30"
				fill="none"
				class="aspect-square fill-white transition-opacity duration-300 group-hover:hidden max-[768px]:hidden"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					d="M0 15C0 6.71573 6.71573 0 15 0C23.2843 0 30 6.71573 30 15C30 23.2843 23.2843 30 15 30C6.71573 30 0 23.2843 0 15Z"
					fill="white"></path>
				<path
					d="M5 13.8005V16.1995H19.3939L12.7967 22.7967L14.5 24.5L24 15L14.5 5.5L12.7967 7.20328L19.3939 13.8005H5Z"
					fill="black"></path>
			</svg>

			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="1em"
				height="1em"
				viewBox="0 0 24 24"
				class="hidden h-6 w-6 max-[768px]:block"
			>
				<path d="M0 0h24v24H0z" fill="none" />
				<path
					fill="currentColor"
					d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91c0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23c-1.48 0-2.93-.39-4.19-1.15l-.3-.17l-3.12.82l.83-3.04l-.2-.32a8.2 8.2 0 0 1-1.26-4.38c.01-4.54 3.7-8.24 8.25-8.24M8.53 7.33c-.16 0-.43.06-.66.31c-.22.25-.87.86-.87 2.07c0 1.22.89 2.39 1 2.56c.14.17 1.76 2.67 4.25 3.73c.59.27 1.05.42 1.41.53c.59.19 1.13.16 1.56.1c.48-.07 1.46-.6 1.67-1.18s.21-1.07.15-1.18c-.07-.1-.23-.16-.48-.27c-.25-.14-1.47-.74-1.69-.82c-.23-.08-.37-.12-.56.12c-.16.25-.64.81-.78.97c-.15.17-.29.19-.53.07c-.26-.13-1.06-.39-2-1.23c-.74-.66-1.23-1.47-1.38-1.72c-.12-.24-.01-.39.11-.5c.11-.11.27-.29.37-.44c.13-.14.17-.25.25-.41c.08-.17.04-.31-.02-.43c-.06-.11-.56-1.35-.77-1.84c-.2-.48-.4-.42-.56-.43c-.14 0-.3-.01-.47-.01"
				/>
			</svg>
		</a>
	</div>
</header>
